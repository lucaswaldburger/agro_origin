/*
 * Big-memory profile -- the first analytical stage (S5 onward).
 *
 * Hard requirement: 1 TiB RAM, because the FCS-GX database
 * (all.gxi 321 GB + all.gxs 177 GB = 464.3 GiB, build 2023-01-24) must be
 * RAM-resident. A 512 GB host does not suffice.
 *
 * Procurement is a STAGE-ZERO BLOCKER on the critical path.
 */

process {
    executor      = 'slurm'
    queue         = 'normal'
    cpus          = 16
    memory        = 64.GB
    errorStrategy = 'retry'
    maxRetries    = 2

    withLabel: 'bigmem' {
        queue  = 'bigmem'
        cpus   = 48
        memory = 1000.GB
    }
    withLabel: 'gpu' {
        queue   = 'gpu'
        clusterOptions = '--gres=gpu:1'
        memory  = 64.GB
    }
}

executor { queueSize = 200 }
workDir  = '/mnt/data/agro/work'
