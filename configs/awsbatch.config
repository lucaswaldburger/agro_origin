/*
 * AWS Batch profile -- us-east-1 ONLY.
 *
 * This is the one place in the program where cloud changes the answer by an
 * order of magnitude. S7 (junction proof) streams 30-60 TB. ENA transatlantic
 * is 2.5 MB/s single-stream and 10.4 MB/s at N=16 -- 9.5 weeks of CONTINUOUS
 * transfer against a stage wall with zero slack.
 *
 * SRA Open Data and Logan both live in us-east-1: ingress is free and
 * throughput is ~10x. Run S7 in-region or accept 2-6 months of streaming.
 *
 * NOTE: there is NO AWS Open Data mirror of GenBank/RefSeq ASSEMBLIES -- only
 * SRA. Assembly acquisition (S0) uses egress-free HTTPS from NCBI, not s3 sync.
 */

process {
    executor      = 'awsbatch'
    queue         = 'agro-origin-spot'
    errorStrategy = 'retry'
    maxRetries    = 3
    cpus          = 16
    memory        = 64.GB

    withLabel: 'bigmem' { cpus = 48; memory = 1000.GB; queue = 'agro-origin-bigmem' }
    withLabel: 'gpu'    { cpus = 8;  memory = 64.GB;   queue = 'agro-origin-gpu'    }
}

aws {
    region = 'us-east-1'
    batch { cliPath = '/home/ec2-user/miniconda/bin/aws'; maxParallelTransfers = 16 }
}

workDir = 's3://agro-origin-work/nextflow'
