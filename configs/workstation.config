/*
 * Workstation profile -- VERIFIED against this machine on 2026-09-24:
 *   8 cores, 15 GB RAM, NO GPU
 *   /        100% full (838 MB of 150 GB)  <-- never write here
 *   /mnt/data  860 GB free of 984 GB
 *
 * Only S0, S1 (moss/fern refutation) and S3 (pilot) are genuinely
 * workstation-class. Everything from S5 requires configs/bigmem.config.
 * See docs/research-program.md §Context -- "the workstation tier is not met
 * and the plan should say so plainly rather than quietly renting a bigger node."
 */

process {
    executor      = 'local'
    cpus          = 2
    memory        = 3.GB
    errorStrategy = 'retry'
    maxRetries    = 2

    withLabel: 'bigmem' {
        // FCS-GX needs its database RAM-resident. A 512 GB workstation is
        // 476 GiB -- below requirement once OS and page cache are counted,
        // squarely in the ~10,000x penalty regime.
        errorStrategy = { error "Requires configs/bigmem.config (1 TiB RAM host)" }
    }
    withLabel: 'gpu' {
        errorStrategy = { error "No GPU on this host. Rent for the S2 LM benchmark (<2 GPU-days)." }
    }
}

executor { queueSize = 4 }

// The root filesystem is full. All scratch and output under /mnt/data.
workDir     = '/mnt/data/agro/work'
params.outdir = '/mnt/data/agro'
