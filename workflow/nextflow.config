// Base configuration. Select an execution profile with -profile.
// Profiles live in ../configs/ and are included below.

manifest {
    name            = 'agro_origin'
    description     = 'Junction-proven fossil record of bacterial DNA in plant genomes'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}

params {
    outdir      = '/mnt/data/agro'
    tracedir    = "${params.outdir}/logs"

    // Detection thresholds -- see docs/research-program.md §4.
    // Frozen at S2 and not tuned afterwards.
    min_flank_kb        = 2       // G6: unique plant-assignable sequence, both junctions
    min_junction_reads  = 3       // G9: independent junction-spanning reads per side
    min_extractions     = 2       // G9/G10: INDEPENDENT DNA extractions, not libraries
    junction_kmer       = 31      // 31-mer chance occurrence in ~700 Gbp is ~3e-7
    ku_martin_identity  = 0.70    // G8: routes to mandatory physical proof, never auto-reject
    tier1_contig_n50_mb = 1.115   // G0: insert + 2x20 kb flanks at P=0.90
}

// Never rebuild against 'latest' -- see docs/research-program.md §Context.
params.fcs_gx_build = '2023-01-24'

profiles {
    workstation { includeConfig '../configs/workstation.config' }
    bigmem      { includeConfig '../configs/bigmem.config'      }
    awsbatch    { includeConfig '../configs/awsbatch.config'    }
}

timeline { enabled = true; file = "${params.tracedir}/timeline.html" }
report   { enabled = true; file = "${params.tracedir}/report.html"   }
trace    { enabled = true; file = "${params.tracedir}/trace.txt"     }
